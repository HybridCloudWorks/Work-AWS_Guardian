        <mxCell df3="1" value="apply (human)" style="endArrow=block;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="hcp" target="aws"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="swim" value="Runtime flow (proven in offline demo; ⚠ enforcement not real until ENFORCE mode)" style="text;html=1;fontSize=12;fontStyle=2;align=left;" vertex="1" parent="1">
